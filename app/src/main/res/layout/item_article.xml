<?xml version="1.0" encoding="utf-8"?>
<!-- Layout cho moi item bai viet trong RecyclerView.
     Theo thiet ke tren bang: ben trai la Title + Content + Views,
     ben phai la anh cover nho (thumbnail). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@android:color/white"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- PHAN BEN TRAI: Title + Content preview + Views -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/text_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#757575"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/text_views"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#1976D2"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- PHAN BEN PHAI: Anh cover thumbnail -->
    <ImageView
        android:id="@+id/image_cover"
        android:layout_width="90dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"/>

</LinearLayout>
